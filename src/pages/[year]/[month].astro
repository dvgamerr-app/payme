---
import Layout from '@/layouts/Layout.astro'
import DashboardPage from '@/components/DashboardPage.svelte'

// Get year and month from URL params
const { year, month } = Astro.params
---

<Layout title="Dashboard - PayMe">
  <DashboardPage client:only="svelte" year={year} month={month} />
</Layout>

<script>
  import { theme } from '@/stores/theme.js'
  import { auth } from '@/stores/auth.js'
  import { isAuthenticated } from '@/lib/api.js'

  // Check if authenticated, redirect to login if not
  if (!isAuthenticated()) {
    window.location.href = '/login'
  } else {
    // Initialize theme
    theme.init()

    // Initialize auth state
    auth.checkAuth()
  }
</script>
