---
import Layout from '@/layouts/Layout.astro'
import StatsDashboard from '@/components/stats/StatsDashboard.svelte'
---

<Layout title="Stats - PayMe">
  <StatsDashboard client:load />
</Layout>

<script>
  import { theme } from '@/stores/theme.js'
  import { auth } from '@/stores/auth.js'
  import { settings } from '@/stores/settings.js'
  import { isAuthenticated } from '@/lib/api.js'

  // Check if authenticated, redirect to login if not
  if (!isAuthenticated()) {
    window.location.href = '/login'
  } else {
    // Initialize theme
    theme.init()

    // Initialize auth state
    auth.checkAuth()

    // Load settings from API
    settings.load()
  }
</script>
